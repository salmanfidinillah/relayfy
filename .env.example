# Salin menjadi .env; file ini tidak menyimpan secret nyata.
RELAYFY_ENV=development
# Mode normal; run_demo.py mengaktifkan persona sintetis dan backend workbuddy sendiri.
RELAYFY_DEMO=false
RELAYFY_AI_BACKEND=api
PUBLIC_ORIGIN=http://127.0.0.1:8765
# Default dev: ~/.relayfy-web/relayfy.sqlite. Produksi: /data/relayfy.sqlite.
# RELAYFY_DB_PATH=/data/relayfy.sqlite
# Aktifkan hanya jika path database benar-benar berada pada volume permanen.
PERSISTENT_STORAGE_CONFIRMED=false
ALLOW_REGISTRATION=true
OPENAI_API_KEY=
# Nama model yang tersedia pada akun API dan mendukung Chat Completions JSON mode.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=35
